PORT=5000

DB_USER=
DB_PASSWORD=
DB_SERVER=
DB_NAME=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

FRONTEND_URL=

JWT_SECRET=

CPACF_DNI=
CPACF_TOMO=
CPACF_FOLIO=

# Litis (asistente con IA)
# Clave del proveedor de IA (Anthropic). Sin clave el backend arranca igual y Litis responde que no está disponible.
ANTHROPIC_API_KEY=
# Modelo a usar. Vacío = claude-sonnet-5-5
LITIS_MODELO=
# Máximo de tokens de cada respuesta de la IA. Vacío = 16000
LITIS_MAX_TOKENS=
# Segundos máximos de espera de cada pedido a la IA (se reintenta una vez). Vacío = 120
LITIS_TIMEOUT_SEGUNDOS=
# Mensajes a Litis permitidos por usuario y por minuto. Vacío = 10
LITIS_LIMITE_MENSAJES_POR_MINUTO=
# Enlaces de descarga permitidos por usuario y por minuto. Vacío = 30
LITIS_LIMITE_ENLACES_POR_MINUTO=
# Máximo de vueltas del ciclo con herramientas por mensaje. Vacío = 5
LITIS_MAX_ITERACIONES=
# Tamaño máximo (en MB) de un documento que Litis puede leer bajo demanda. Vacío = 5
LITIS_LECTURA_MAX_MB=

# Resúmenes de documentos con IA (HU42)
# "true" activa el proceso en segundo plano que resume los documentos subidos. Vacío = desactivado
RESUMEN_IA_HABILITADO=
# Cada cuánto corre el proceso, en formato cron. Vacío = cada 2 minutos (*/2 * * * *)
RESUMEN_IA_CRON=
# Documentos que procesa por ejecución. Vacío = 5
RESUMEN_IA_LOTE=
# Intentos antes de dejar un documento con error. Vacío = 3
RESUMEN_IA_MAX_INTENTOS=
# Tamaño máximo en MB de un archivo para resumirlo (los más grandes se omiten). Vacío = 10, igual que el límite de subida
RESUMEN_IA_MAX_MB=
